---
import MainLayout from '../layouts/main-layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<MainLayout title="John Kim — Software & AI Engineer">
  <main class="max-w-2xl mx-auto px-6 py-16 text-slate-800 dark:text-slate-200 font-sans leading-relaxed">
    
    <header class="mb-12">
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white mb-2">John Kim</h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 font-medium">Frontend / Full-Stack & AI Agent Engineer</p>
    </header>

    <section class="mb-12 space-y-4 text-base">
      <p>
        Hi, I'm Kim 👋. I build modern web applications, AI agent frameworks, and developer tools with a focus on speed, clarity, and low friction.
      </p>
      <p>
        Currently working at <a href="https://github.com/Kerubi-5" class="underline text-blue-600 dark:text-blue-400 hover:text-blue-800">@baoss-dev agency</a> and building <a href="https://github.com/Kerubi-5/hermes-agent" class="underline text-blue-600 dark:text-blue-400 hover:text-blue-800">Atlas</a> — an autonomous operating system for human & AI co-working.
      </p>
    </section>

    <section class="mb-12">
      <h2 class="text-xl font-semibold text-slate-900 dark:text-white mb-4 border-b border-slate-200 dark:border-slate-800 pb-2">Projects</h2>
      <ul class="space-y-4">
        <li>
          <a href="https://github.com/Kerubi-5/kairos" class="font-medium text-slate-900 dark:text-slate-100 hover:underline">KairOS</a>
          <span class="text-slate-500 dark:text-slate-400 text-sm ml-2">— Executive function co-pilot & task engine</span>
        </li>
        <li>
          <a href="https://github.com/Kerubi-5/metis" class="font-medium text-slate-900 dark:text-slate-100 hover:underline">Metis</a>
          <span class="text-slate-500 dark:text-slate-400 text-sm ml-2">— Knowledge synthesis & accountability platform</span>
        </li>
        <li>
          <a href="https://github.com/Kerubi-5/alba-dashboard" class="font-medium text-slate-900 dark:text-slate-100 hover:underline">Alba Dashboard</a>
          <span class="text-slate-500 dark:text-slate-400 text-sm ml-2">— Management interface for facility operations</span>
        </li>
      </ul>
    </section>

    <section class="mb-12">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-2 mb-4">
        <h2 class="text-xl font-semibold text-slate-900 dark:text-white">Writing</h2>
        <a href="/blog" class="text-xs font-medium text-blue-600 dark:text-blue-400 hover:underline">View all →</a>
      </div>
      {posts.length > 0 ? (
        <ul class="space-y-4">
          {posts.slice(0, 3).map((post) => (
            <li>
              <a href={`/blog/${post.slug}`} class="group flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
                <span class="font-medium text-slate-900 dark:text-slate-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                  {post.data.title}
                </span>
                <time class="text-xs text-slate-500 dark:text-slate-400 font-mono shrink-0 sm:ml-4">
                  {post.data.date}
                </time>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="text-slate-500 dark:text-slate-400 italic text-sm">Coming soon...</p>
      )}
    </section>

    <footer class="pt-8 border-t border-slate-200 dark:border-slate-800 flex flex-wrap gap-6 text-sm font-medium">
      <a href="https://www.linkedin.com/in/john-kim-q-4507521b8/" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">LinkedIn</a>
      <a href="https://github.com/Kerubi-5" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">GitHub</a>
      <a href="https://x.com/Kerubi5s" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline">X (Twitter)</a>
      <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="text-blue-600 dark:text-blue-400 hover:underline font-semibold">📄 Resume (ATS)</a>
    </footer>

  </main>
</MainLayout>
