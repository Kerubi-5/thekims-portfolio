---
import MainLayout from '../../layouts/main-layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
---

<MainLayout title={`${post.data.title} — John Kim`} description={post.data.description}>
  <main class="max-w-2xl mx-auto px-6 py-16 text-slate-800 dark:text-slate-200 font-sans leading-relaxed">
    <nav class="mb-8">
      <a href="/blog" class="text-sm font-medium text-blue-600 dark:text-blue-400 hover:underline">← Back to Writing</a>
    </nav>

    <header class="mb-10">
      <time class="text-xs text-slate-500 dark:text-slate-400 font-mono">{post.data.date}</time>
      <h1 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white mt-2 mb-4 leading-tight">{post.data.title}</h1>
      <p class="text-lg text-slate-600 dark:text-slate-400 font-medium italic leading-relaxed border-l-2 border-blue-500 pl-4 py-1">
        {post.data.description}
      </p>
    </header>

    <article class="prose dark:prose-invert max-w-none prose-slate text-base leading-relaxed space-y-6">
      <Content />
    </article>
  </main>
</MainLayout>
