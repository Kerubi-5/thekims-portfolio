---
---

<section class="py-20 md:py-28 relative overflow-hidden">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <!-- Status Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-brand-500/10 border border-brand-500/20 text-brand-400 text-xs font-medium font-mono mb-6">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        Available for AI Agent & Fullstack Engineering Projects
      </div>

      <!-- Main Headline -->
      <h1 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-slate-100 tracking-tight leading-none mb-6">
        Hi, I'm <span class="bg-gradient-to-r from-brand-400 via-blue-400 to-purple-400 bg-clip-text text-transparent">John Kim</span>.
      </h1>

      <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-300 tracking-tight mb-6">
        Architecting <span class="text-brand-400">Autonomous AI Agents</span> & Scalable Web Applications.
      </h2>

      <p class="text-base sm:text-lg text-slate-400 leading-relaxed mb-8 max-w-2xl">
        Software Engineer and AI/Agent Engineer with 5+ years of experience building scalable web apps, intelligent agentic workflows, and LLM-powered operating systems. Specialized in <strong class="text-slate-200">Next.js</strong>, <strong class="text-slate-200">TypeScript</strong>, <strong class="text-slate-200">Python</strong>, and <strong class="text-slate-200">Autonomous Multi-Agent Systems</strong>.
      </p>

      <!-- CTA Buttons -->
      <div class="flex flex-wrap items-center gap-4 mb-12">
        <a
          href="#projects"
          class="px-6 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-500 text-white font-semibold text-sm shadow-lg shadow-brand-500/25 transition-all hover:shadow-brand-500/40 hover:-translate-y-0.5"
        >
          View Key Projects
        </a>
        <a
          href="https://calendly.com/jkim-querobines/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-xl bg-slate-800/80 hover:bg-slate-700/80 text-slate-200 border border-slate-700 font-semibold text-sm transition-all hover:-translate-y-0.5"
        >
          Schedule 30m Call
        </a>
        <a
          href="https://github.com/Kerubi-5"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 font-semibold text-sm transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 4.335 9.747 10 11.25.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.39-1.305.705-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/john-kim-q-4507521b8/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-800 font-semibold text-sm transition-all flex items-center gap-2"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
          LinkedIn
        </a>
      </div>

      <!-- Quick Metrics Grid -->
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 pt-8 border-t border-slate-800/60">
        <div>
          <div class="text-2xl font-extrabold text-slate-100 font-mono">5+ Years</div>
          <div class="text-xs text-slate-400 font-medium">Software Engineering</div>
        </div>
        <div>
          <div class="text-2xl font-extrabold text-brand-400 font-mono">Cum Laude</div>
          <div class="text-xs text-slate-400 font-medium">BS IT (PUP 2022)</div>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <div class="text-2xl font-extrabold text-purple-400 font-mono">AI & Agents</div>
          <div class="text-xs text-slate-400 font-medium">Fullstack Engineering</div>
        </div>
      </div>
    </div>
  </div>
</section>
