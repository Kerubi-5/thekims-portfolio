---
const stackCategories = [
  {
    name: 'AI & Agent Engineering',
    color: 'text-purple-400 border-purple-500/20 bg-purple-500/10',
    skills: [
      'Autonomous AI Agents',
      'Multi-Agent Architectures',
      'Hermes Agent Framework',
      'LLMs & Prompt Engineering',
      'Vector Databases & Embeddings',
      'RAG & Fact Stores',
      'PyTorch / Transformers',
    ],
  },
  {
    name: 'Frontend Development',
    color: 'text-brand-400 border-brand-500/20 bg-brand-500/10',
    skills: [
      'Next.js',
      'React',
      'TypeScript',
      'JavaScript (ES6+)',
      'Astro',
      'Tailwind CSS',
      'HTML5 / CSS3 / SASS',
      'Gatsby.js',
    ],
  },
  {
    name: 'Backend & Systems',
    color: 'text-emerald-400 border-emerald-500/20 bg-emerald-500/10',
    skills: [
      'Python',
      'Node.js',
      'FastApi',
      'REST & GraphQL APIs',
      'WebSockets',
      'Redis & Task Queues',
      'SQLite / PostgreSQL',
      'Contentful CMS',
    ],
  },
  {
    name: 'Tools & DevOps',
    color: 'text-amber-400 border-amber-500/20 bg-amber-500/10',
    skills: [
      'Git & GitHub',
      'Docker',
      'CI/CD Pipelines',
      'Nx Monorepo',
      'Storybook',
      'Linux / Bash',
      'Make.com / Automation',
      'Vercel',
    ],
  },
];
---

<section id="stack" class="py-20 border-t border-slate-800/60 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 text-brand-400 text-xs font-mono font-bold tracking-wider uppercase mb-2">
        // Technical Expertise
      </div>
      <h2 class="text-3xl font-extrabold text-slate-100 tracking-tight">
        Skills & Stack
      </h2>
      <p class="text-slate-400 text-sm mt-2 max-w-xl">
        Technologies, frameworks, and core tools used in my daily engineering workflow.
      </p>
    </div>

    <!-- Stack Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {stackCategories.map((cat) => (
        <div class="bg-slate-900/60 border border-slate-800 rounded-2xl p-6 flex flex-col justify-between">
          <div>
            <div class={`inline-block text-xs font-mono font-bold px-3 py-1 rounded-full border mb-4 ${cat.color}`}>
              {cat.name}
            </div>
            <ul class="space-y-2.5">
              {cat.skills.map((skill) => (
                <li class="flex items-center gap-2 text-sm text-slate-300 font-medium">
                  <span class="w-1.5 h-1.5 rounded-full bg-slate-600"></span>
                  <span>{skill}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
