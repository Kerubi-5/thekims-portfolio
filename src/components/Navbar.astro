---
const navLinks = [
  { name: 'About', href: '#about' },
  { name: 'Projects', href: '#projects' },
  { name: 'Experience', href: '#experience' },
  { name: 'Stack', href: '#stack' },
  { name: 'Contact', href: '#contact' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-slate-950/80 border-b border-slate-800/60 transition-all duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo / Brand -->
      <a href="#" class="flex items-center gap-2 group">
        <span class="w-8 h-8 rounded-lg bg-gradient-to-tr from-brand-600 to-purple-600 text-white font-mono font-bold flex items-center justify-center text-sm shadow-md shadow-brand-500/20 group-hover:scale-105 transition-transform">
          JK
        </span>
        <span class="font-bold text-slate-100 group-hover:text-brand-400 transition-colors tracking-tight">
          John Kim Querobines
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-6">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-slate-300 hover:text-brand-400 transition-colors py-1"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="https://github.com/Kerubi-5"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800/60 transition-colors"
          aria-label="GitHub Profile"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 4.335 9.747 10 11.25.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.39-1.305.705-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a
          href="https://www.linkedin.com/in/john-kim-querobines-4507521b8/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-slate-400 hover:text-white p-2 rounded-lg hover:bg-slate-800/60 transition-colors"
          aria-label="LinkedIn Profile"
        >
          <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a
          href="https://calendly.com/jkim-querobines/30min"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-semibold px-3.5 py-2 rounded-lg bg-brand-600 hover:bg-brand-500 text-white shadow-sm shadow-brand-500/20 transition-all hover:shadow-brand-500/40"
        >
          Book 30m Call
        </a>
      </div>
    </div>
  </div>
</header>
